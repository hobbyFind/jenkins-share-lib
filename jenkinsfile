@Library('my-shared-lib') _
import com.company.utils.Logger

// 调用库的示例

pipeline {
    agent any
    
    environment {
        APP_NAME = 'my-java-app'
        TAG = "${BUILD_NUMBER}"
        REGISTRY = 'harbor.mycompany.com'
        PROJECT = 'backend'
    }

    stages {
        stage('Cleanup') {
            steps {
                // 调用封装好的步骤，传入脚本名和参数
                runScript(
                    name: 'cleanup.sh',
                    args: '--env production --force'
                )
            }
        }
        
        stage('Build & Push Image') {
            steps {
                script {
                    // 1. 登录
                    dockerOps.login(
                        registry: env.REGISTRY, 
                        credentialsId: 'harbor-cred-id'
                    )
                    
                    // 2. 构建并推送
                    def fullImage = dockerOps.buildAndPush(
                        registry: env.REGISTRY,
                        project: env.PROJECT,
                        appName: env.APP_NAME,
                        tag: env.TAG,
                        dockerfilePath: 'Dockerfile'
                    )
                    
                    // 将完整镜像地址存入环境变量供后续使用
                    env.FULL_IMAGE = fullImage
                    Logger.info("镜像以存入环境变量")
                }
            }
        }
        
        stage('Deploy to K8s') {
            steps {
                script {
                    // 3. 部署 (注意：k8sDeploy 使用了 call 方法，所以可以直接当函数名调用)
                    k8sDeploy(
                        kubeConfigId: 'k8s-admin-config',
                        namespace: 'production',
                        deploymentName: env.APP_NAME,
                        image: env.FULL_IMAGE,
                        timeout: 3
                    )
                }
            }
        }
    }
    
    post {
        success {
			wrap([$class: 'BuildUser']) {
				script {
					currentBuild.description = "执行人: ${env.BUILD_USER} <br> 分支: ${params.Branch} <br> 服务类型: ${params.serverType} <br> 方式: ${params.Action} <br> 目标服务器: {params.Server}"
				}
				dingTalk(
					projectType: 'zidingyi',
					WEBHOOK_URL: "https://oapi.dingtalk.com/robot/send?access_token=132af8f0ce30f447549125f8d467c1f78606659ba6900ff63ff7b875c61baff8",
					extraInfo: [
						"服务类型": "${params.serverType}",
						"部署环境": "${params.Server}",
						"部署方式": "${params.Action}",
						"构建分支": "${params.Branch}"
					]
					//footerTip: "[点击查看构建详情](${env.BUILD_URL})"
				)
			}
        }
        failure {
			wrap([$class: 'BuildUser']) {
				script {
					currentBuild.description = "执行人: ${env.BUILD_USER} "
				}
				dingTalk(
					projectType: 'zidingyi',
					isAtAll: true,
					//atMobiles: [""],
					WEBHOOK_URL: "",
					extraInfo: [
						"服务类型": "${params.serverType}",
						"部署环境": "${params.Server}",
						"部署方式": "${params.Action}",
						"构建分支": "${params.Branch}"
					],
					footerTip: "当前任务失败咯，请前往控制台查看详情"
				)
			}
        }
    }
}